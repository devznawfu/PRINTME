FLASK_ENV=dev
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite:///instance/printme.db
# Production only: the admin PC's reserved IP on the dedicated customer
# router (e.g. 192.168.50.2) - locks the server to that network only.
# Leave commented out (defaults to 0.0.0.0, every interface) in dev.
#SERVE_HOST=192.168.50.2
