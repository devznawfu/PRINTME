FLASK_ENV=dev
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
DATABASE_URL=sqlite:///instance/printme.db
# Production only: the admin PC's reserved IP on the dedicated customer
# router (e.g. 192.168.50.2) - locks the server to that network only.
# Leave commented out (defaults to 0.0.0.0, every interface) in dev.
#SERVE_HOST=192.168.50.2
# The customer WiFi network's own SSID/password (from the dedicated
# router's own settings, not chosen by this app) - printed as a
# scannable QR code on the dashboard's "Print a sign for the counter"
# page. Leave both unset to omit that QR code from the sign.
#CUSTOMER_WIFI_SSID=PRINTME!
#CUSTOMER_WIFI_PASSWORD=change-me
