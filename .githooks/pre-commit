#!/usr/bin/env bash
# Blocks any commit made under the wrong git identity.

ALLOWED_EMAIL="impasjohnfranz@gmail.com"
current_email=$(git config user.email)

if [ "$current_email" != "$ALLOWED_EMAIL" ]; then
  echo "❌ Commit blocked."
  echo "   Current git email: $current_email"
  echo "   Expected:          $ALLOWED_EMAIL"
  echo ""
  echo "   Fix with:"
  echo "   git config user.email \"$ALLOWED_EMAIL\""
  exit 1
fi

exit 0